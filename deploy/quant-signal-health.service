[Unit]
Description=Quant signal production health check
After=quant-signal.service

[Service]
Type=oneshot
SuccessExitStatus=1
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/quant-signal
EnvironmentFile=/home/ubuntu/quant-signal/.env
ExecStart=/usr/bin/env VPS_RUNTIME_ROLE=recommendation_only /home/ubuntu/quant-signal/deploy/check-production-health.sh
