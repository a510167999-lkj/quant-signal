[Unit]
Description=Post-close scan for planned exits (profit-lock / pre-calendar-gap)
After=network-online.target quant-signal-recommend.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/quant-signal
EnvironmentFile=/home/ubuntu/quant-signal/.env
ExecStart=/usr/bin/env VPS_RUNTIME_ROLE=recommendation_only /home/ubuntu/quant-signal/.venv/bin/python -m app.jobs monitor-planned-exits
TimeoutStartSec=20min
