[Unit]
Description=A-share Quant Signal Platform
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/quant-signal
EnvironmentFile=/home/ubuntu/quant-signal/.env
ExecStart=/usr/bin/env VPS_RUNTIME_ROLE=recommendation_only /home/ubuntu/quant-signal/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
