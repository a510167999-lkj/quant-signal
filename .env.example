# Optional. If both values are empty, API auth is disabled.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Comma-separated frontend origins if you serve a separate mini-program/web client.
CORS_ORIGINS=

# In-memory market-data cache. Keep this above 60 seconds.
CACHE_TTL_SECONDS=1800
# Market data provider: akshare or tushare. Tushare works on Linux VPS with a token.
MARKET_DATA_PROVIDER=akshare
# Persistent daily K-line cache. This is the main speed path for 09:32 scans.
MARKET_DATA_CACHE_PATH=data/market_data_cache.sqlite
# Optional Tushare Pro token. Set MARKET_DATA_PROVIDER=tushare to use it as primary source.
TUSHARE_TOKEN=
TUSHARE_FALLBACK_TO_AKSHARE=1
# Optional live L1 quote overlay for morning recommendations and trading-session alerts.
ENABLE_MOOTDX_L1_CONTEXT=0
# Comma-separated TongDaXin quote servers, e.g. 58.63.254.217:7709,116.205.171.132:7709.
MOOTDX_SERVERS=
MOOTDX_TIMEOUT_SECONDS=3

# Personal watchlist store. The default path is ignored by git.
WATCHLIST_PATH=data/watchlist.json
HOLDINGS_PATH=data/holdings.json
LATEST_RECOMMENDATIONS_PATH=data/recommendations_latest.json
RECOMMENDATION_HISTORY_PATH=data/recommendations_history.jsonl
RECOMMENDATION_LOCK_PATH=data/recommendations.lock
ALERTS_PATH=data/alerts.jsonl
UNIVERSE_CACHE_PATH=data/a_share_universe.json
INDUSTRY_CACHE_PATH=data/industry_strength.json
INDUSTRY_HISTORY_CACHE_DIR=data/industry_history
NEWS_CACHE_PATH=data/news_context.json
ANNOUNCEMENT_CACHE_PATH=data/announcement_context.json
FUND_FLOW_CACHE_PATH=data/fund_flow_context.json
TRADE_CALENDAR_CACHE_PATH=data/trade_calendar.json

# Default is direct market-data requests. Set to 1 only if your VPS must use a proxy.
MARKET_DATA_USE_PROXY=0
AKSHARE_MAX_RETRIES=3
AKSHARE_RETRY_BASE_DELAY_SECONDS=0.8
AKSHARE_RETRY_JITTER_SECONDS=0.4
# Optional total retry budget per wrapped call. 0 means no extra outer budget.
AKSHARE_MAX_ELAPSED_SECONDS=0
AKSHARE_STATUS_PATH=data/akshare_status.json

# A-share opportunity discovery. Daily job builds an industry-stratified pool, then deep-scans this many names.
SCAN_MAX_DEEP=500
# Fast intraday slots use this cap; post-close review still uses SCAN_MAX_DEEP.
INTRADAY_SCAN_MAX_DEEP=120
SCAN_RESULT_LIMIT=3
SCAN_MIN_AMOUNT=30000000
SCAN_MIN_PRICE=3
SCAN_MAX_PRICE=300
SCAN_INDUSTRY_TOP_N=3
SCAN_PER_INDUSTRY_TOP_N=3
INDUSTRY_TOP_N=50
MIN_BACKTEST_TRADES=1
MIN_BACKTEST_WIN_RATE=35
MIN_BACKTEST_AVG_RETURN=0
MAX_BACKTEST_DRAWDOWN=28
MAX_BACKTEST_AVG_ADVERSE=5
MAX_ENTRY_GAP_UP_PCT=6
MAX_ENTRY_GAP_DOWN_PCT=7
LOCKED_LIMIT_GAP_PCT=9.3
MAX_ENTRY_INTRADAY_RANGE_PCT=8

# Production recommendation strict gate. The current validated slot-exit research profile
# uses a 5-day hard stop, 3 active slots, favorable/neutral markets, broad market breadth,
# a 20-day breakout, and a 2-5% signal-day gap.
RECOMMENDATION_MIN_SIGNAL_SCORE=2
RECOMMENDATION_REQUIRED_SIGNAL_TAGS=breadth_advancing_gte_50,breakout_20d,price_gap_up_2_to_5
RECOMMENDATION_REQUIRE_ALL_SIGNAL_TAGS=1
RECOMMENDATION_EXCLUDED_SIGNAL_TAGS=
RECOMMENDATION_ALLOWED_MARKET_LEVELS=favorable,neutral
RECOMMENDATION_SYMBOL_COOLDOWN_DAYS=5

ENABLE_NEWS_CONTEXT=1
ENABLE_ANNOUNCEMENT_CONTEXT=1
ENABLE_FUND_FLOW_CONTEXT=1
NEWS_LOOKBACK_DAYS=14
ANNOUNCEMENT_LOOKBACK_DAYS=30

# Trading-session alert monitor for recently recommended A-shares.
MONITOR_RECENT_DAYS=5
MONITOR_INTRADAY_DROP_PCT=4
MONITOR_PROFIT_LOCK_ACTIVATION_PCT=18
# Post-close planned-exit: exit before calendar gaps >= N days (0 disables; 7 aligns with research target).
MONITOR_PRE_EXIT_CALENDAR_GAP_DAYS=7
# Performance tracking: fallback holding days for the strategy-exit (profit-lock + calendar-gap) return.
PERFORMANCE_STRATEGY_HOLD_DAYS=5

# Optional generic JSON webhook. Leave empty to store alerts only in the web dashboard.
ALERT_WEBHOOK_URL=

# Structured logging. INFO 默认输出到 stderr，systemd journald 自动收集。
LOG_LEVEL=INFO
# 可选日志文件路径（含父目录会自动创建）。留空则只输出到 stderr。
LOG_PATH=
